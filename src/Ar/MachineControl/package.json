{
  "name": "@loupeteam/piperprog",
  "version": "1.0.0",
  "description": "This is a program package that will add the Machine HMI Program and Machine Program to your AS project",
  "homepage": "https://loupeteam.github.io/LoupeDocs/programs/piperprog.html",
  "author": "Loupe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loupeteam/Piper.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@loupeteam/logthat": ">=1.0.0",
    "@loupeteam/piper": ">=1.0.0",
    "@loupeteam/hmitools": ">=1.0.0"
  },
  "lpm": {
    "type": "program",
    "logical": {
      "destination": "MachineControl"
    },
    "physical": {
      "cpu": [
        {
          "source": "MachineProg",
          "destination": "TC3"
        },
        {
          "source": "MachineHMI",
          "destination": "TC3"
        }
      ]
    }
  }
}
